# Gmail API para recuperação de senha. Configure os valores privados no servidor.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=ManiService <maniservice.contato@gmail.com>

# URL pública do frontend que receberá o link de redefinição
APP_URL=http://localhost:5000

# Armazenamento persistente de fotos no Supabase Storage (produção)
# Use a URL do projeto e a service_role key em variáveis seguras do servidor/Render.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-secreta-no-ambiente-do-servidor
SUPABASE_STORAGE_BUCKET=maniservice-media
